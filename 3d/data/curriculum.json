 },
 "zoneFacts": {
  "esquelet.cap": {
   "ca": "Al cap hi ha els ossos del crani i els de la cara.",
   "es": "En la cabeza están los huesos del cráneo y los de la cara.",
   "zh": "头部有颅骨和面部的骨头。",
   "en": "The head has the skull bones and the face bones."
  },
  "esquelet.tronc": {
   "ca": "Al tronc hi ha la columna vertebral, les costelles i l'estern.",
   "es": "En el tronco están la columna vertebral, las costillas y el esternón.",
   "zh": "躯干有脊柱、肋骨和胸骨。",
   "en": "The trunk has the spine, the ribs and the sternum."
  },
  "esquelet.ext": {
   "ca": "A les extremitats hi ha ossos llargs i, a les mans i als peus, molts ossos petits.",
   "es": "En las extremidades hay huesos largos y, en manos y pies, muchos huesos pequeños.",
   "zh": "四肢有长骨；手和脚上有很多小骨头。",
   "en": "The limbs have long bones, and the hands and feet have many small bones."
  },
  "musculatura.cap": {
   "ca": "Músculs plans i anulars: els fem servir per parlar, mastegar i gesticular.",
   "es": "Músculos planos y anulares: sirven para hablar, masticar y gesticular.",
   "zh": "扁平肌和环形肌：用来说话、咀嚼和做表情。",
   "en": "Flat and ring-shaped muscles: we use them to talk, chew and make faces."
  },
  "musculatura.tronc": {
   "ca": "Músculs grans i plans: mantenen dreta la columna, protegeixen l'abdomen i ajuden a respirar.",
   "es": "Músculos grandes y planos: mantienen recta la columna, protegen el abdomen y ayudan a respirar.",
   "zh": "大而扁的肌肉：让脊柱挺直、保护腹部、帮助呼吸。",
   "en": "Big flat muscles: keep the spine straight, protect the belly and help us breathe."
  },
  "musculatura.ext": {
   "ca": "Molts són llargs: mouen els braços, les cames, les mans i els peus.",
   "es": "Muchos son largos: mueven brazos, piernas, manos y pies.",
   "zh": "很多是长肌：让手臂、腿、手和脚动起来。",
   "en": "Many are long: they move the arms, legs, hands and feet."
  }
 },
